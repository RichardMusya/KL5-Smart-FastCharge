#!/sbin/sh

umask 022

OUTFD=$2
ZIPFILE=$3

ui_print() {
    echo "$1"
    if [ -n "$OUTFD" ]; then
        echo "ui_print $1" >&$OUTFD
        echo "ui_print" >&$OUTFD
    fi
}

if [ -z "$ZIPFILE" ]; then
    ui_print "ERROR: ZIP archive not provided."
    exit 1
fi

TMPDIR="${TMPDIR:-/dev/tmp}"

mkdir -p "$TMPDIR"

if ! command -v magisk >/dev/null 2>&1; then
    ui_print "ERROR: Magisk installer unavailable."
    exit 1
fi

exec magisk --install-module "$ZIPFILE"
